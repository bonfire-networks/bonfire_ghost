<div class="space-y-6">
  {!-- Header --}
  <div class="flex items-center justify-between">
    <!-- <div>
      <h2 class="text-2xl font-bold">{l("Ghost Blog Integration")}</h2>
      <p class="text-base-content">{l("Connect and manage your Ghost blog")}</p>
    </div> -->
    <button
      :if={@settings}
      class="btn btn-primary btn-sm gap-2"
      phx-click="Bonfire.Ghost:refresh"
      phx-target={@myself}
    >
      <span class="iconify" data-icon="heroicons:arrow-path-20-solid" />
      {l("Refresh")}
    </button>
  </div>

  {!-- Loading State --}
  {#if @loading}
    <div class="flex items-center justify-center py-12">
      <span class="loading loading-spinner loading-lg" />
    </div>

    {!-- Not Configured State --}
  {#elseif is_nil(@settings)}
    <div class="alert">
      <span class="iconify text-xl" data-icon="heroicons:exclamation-triangle" />
      <div>
        <h3 class="font-bold">{l("Ghost not configured")}</h3>
        <p class="text-sm">{l("Set the following environment variables to connect your Ghost blog:")}</p>
        <pre class="mt-2 text-xs bg-base-200 p-3 rounded overflow-x-auto">GHOST_URL=https://your-blog.ghost.io
GHOST_CONTENT_API_KEY=your_content_api_key
GHOST_ADMIN_API_KEY=id:secret  # Optional, for members</pre>
      </div>
    </div>

    {!-- Connected State --}
  {#else}
    {!-- Blog Details Card --}
    <div class="card bg-base-100 border border-base-content/10">
      {#if cover_image = @settings["cover_image"]}
        <figure class="h-32 overflow-hidden">
          <img src={cover_image} alt="" class="w-full object-cover">
        </figure>
      {/if}
      <div class="card-body">
        <div class="flex items-start gap-4">
          {#if logo = @settings["logo"] || @settings["icon"]}
            <img src={logo} alt="" class="w-16 h-16 rounded object-contain bg-base-200">
          {#else}
            <div class="w-16 h-16 rounded bg-base-200 flex items-center justify-center">
              <span class="iconify text-3xl text-base-content/50" data-icon="simple-icons:ghost" />
            </div>
          {/if}
          <div class="flex-1">
            <h3 class="card-title text-xl">
              {@settings["title"] || l("Untitled Blog")}
              <span class="badge badge-sm">{@settings["version"]}</span>
            </h3>
            <p :if={desc = @settings["description"]} class="text-base-content">{desc}</p>
            <a
              href={@settings["url"]}
              target="_blank"
              rel="noopener"
              class="link link-primary text-sm flex items-center gap-1 mt-1"
            >
              {@settings["url"]}
              <span class="iconify" data-icon="heroicons:arrow-top-right-on-square-20-solid" />
            </a>
          </div>
        </div>

        <div class="divider my-2" />

        {!-- Blog Stats/Info --}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
          <div>
            <span class="text-muted">{l("Language")}</span>
            <p class="font-medium">{@settings["locale"] || @settings["lang"] || "-"}</p>
          </div>
          <div>
            <span class="text-muted">{l("Timezone")}</span>
            <p class="font-medium">{@settings["timezone"] || "-"}</p>
          </div>
          <div>
            <span class="text-muted">{l("Members")}</span>
            <p class="font-medium">
              {#if @settings["members_enabled"]}
                <span class="text-success">{l("Enabled")}</span>
              {#else}
                <span class="text-base-content/50">{l("Disabled")}</span>
              {/if}
            </p>
          </div>
          <div>
            <span class="text-muted">{l("Paid Tiers")}</span>
            <p class="font-medium">
              {#if @settings["paid_members_enabled"]}
                <span class="text-success">{l("Enabled")}</span>
              {#else}
                <span class="text-base-content/50">{l("Disabled")}</span>
              {/if}
            </p>
          </div>
        </div>
      </div>
    </div>

    {!-- Gated Login Mode --}
    {#if Bonfire.Ghost.admin_configured?()}
      <div class="card bg-base-100 border border-base-content/10">
        <div class="card-body gap-4">
          <form phx-change="Bonfire.Common.Settings:set">
            <Bonfire.UI.Common.SettingsToggleLive
              keys={[:bonfire_ui_me, :login, :passwordless_only]}
              scope={:instance}
              name={l("Gated login (Ghost members only)")}
              description={l(
                "Hide the password and signup forms on the login page. Members existing in Ghost get a passwordless email link instead."
              )}
            />
          </form>

          {#if Bonfire.Common.Settings.get(
              [:bonfire_ui_me, :login, :passwordless_only],
              false,
              :instance
            ) in [true, "true", "1", "yes"]}
            <form phx-submit="Bonfire.Common.Settings:save">
              <Bonfire.UI.Common.SettingsInputLive
                keys={[:bonfire_ui_me, :login, :external_signup_url]}
                scope={:instance}
                name={l("External signup URL")}
                description={l(
                  "Optional. When set, a Sign up button is shown next to the login button and redirects to this URL (e.g. your Ghost subscribe page)."
                )}
                placeholder="https://your-blog.ghost.io/#/portal/signup"
                class="input input-bordered input-sm flex-1"
              />
            </form>
          {/if}
        </div>
      </div>
    {/if}

    {!-- Article import (on-demand embeds + opt-in webhook auto-import) --}
    {#if Bonfire.Ghost.configured?()}
      <div class="card bg-base-100 border border-base-content/10">
        <div class="card-body gap-4">
          {!-- Default author — used by BOTH iframe/embed imports and webhook auto-import,
               so it is not gated behind the auto-import toggle. --}
          <form phx-submit="Bonfire.Common.Settings:save">
            <Bonfire.UI.Common.SettingsInputLive
              keys={[:bonfire_ghost, :auto_import_as]}
              scope={:instance}
              name={l("Default author for imported articles")}
              description={l(
                "User ID that imported Ghost articles are attributed to when the article's Ghost author doesn't map to a local user. Used for both embedded articles and webhook auto-import."
              )}
              placeholder="user ID"
              class="input input-bordered input-sm flex-1"
            />
          </form>

          {!-- Default group/topic — imported articles are posted into this group (or
               topic) so they appear in its feed. Used by BOTH webhook auto-import and
               embeds; an embed's `data-group-id` param still overrides per-request. --}
          <form phx-submit="Bonfire.Common.Settings:save">
            <Bonfire.UI.Common.SettingsInputLive
              keys={[:bonfire_ghost, :post_into_group]}
              scope={:instance}
              name={l("Post imported articles into group/topic")}
              description={l(
                "Optional. ID (or username) of a group or topic that imported Ghost articles are posted into, so they show up in its feed. Used for both embedded articles and webhook auto-import (an embed's data-group-id parameter overrides this)."
              )}
              placeholder="group ID or @username"
              class="input input-bordered input-sm flex-1"
            />
          </form>

          {#if Bonfire.Common.Settings.get([:bonfire_ghost, :post_into_group], nil, :instance) not in [
              nil,
              ""
            ]}
            <form phx-change="Bonfire.Common.Settings:set">
              <Bonfire.UI.Common.SettingsToggleLive
                keys={[:bonfire_ghost, :require_topic]}
                scope={:instance}
                name={l("Only import articles matching a topic")}
                description={l(
                  "When enabled, only import articles whose primary tag maps to a topic within the group above. Articles that don't match a topic are skipped."
                )}
              />
            </form>
          {/if}

          <div class="divider my-0" />

          <form phx-change="Bonfire.Common.Settings:set">
            <Bonfire.UI.Common.SettingsToggleLive
              keys={[:bonfire_ghost, :auto_import_articles]}
              scope={:instance}
              name={l("Auto-import articles from Ghost")}
              description={l(
                "When a Ghost article is published, automatically create a matching post here (and update/hide it when the article is edited/unpublished). Requires configuring Ghost webhooks (see below)."
              )}
            />
          </form>

          {#if Bonfire.Common.Settings.get(
              [:bonfire_ghost, :auto_import_articles],
              false,
              :instance
            ) in [true, "true", "1", "yes"]}
            <div class="text-sm text-base-content mt-2">
              <p class="font-semibold">{l("Configure these webhooks in Ghost admin → Settings → Integrations:")}</p>
              <ul class="list-disc list-inside mt-1 font-mono text-xs">
                <li>Post published → <span>{Bonfire.Common.URIs.base_url()}/ghost/webhook/post.published</span></li>
                <li>Published post updated → <span>{Bonfire.Common.URIs.base_url()}/ghost/webhook/post.published.edited</span></li>
                <li>Post unpublished → <span>{Bonfire.Common.URIs.base_url()}/ghost/webhook/post.unpublished</span></li>
                <li>Post deleted → <span>{Bonfire.Common.URIs.base_url()}/ghost/webhook/post.deleted</span></li>
              </ul>
              <p class="mt-1">{l("Set the same secret as GHOST_WEBHOOK_SECRET on each webhook.")}</p>
            </div>
          {/if}
        </div>
      </div>
    {/if}

    {!-- Tiers Section --}
    {#if @tiers != []}
      <div class="card bg-base-100 border border-base-content/10">
        <div class="card-body">
          <div class="flex items-center justify-between mb-4 gap-4 flex-wrap">
            <h3 class="card-title">
              {l("Membership Tiers")}
              <span class="badge badge-ghost">{length(@tiers)}</span>
            </h3>
            <div class="flex items-center gap-3">
              {#if @last_sync}
                <span class="text-xs text-muted">
                  {l("Last sync")}: {format_date(DateTime.to_iso8601(@last_sync.at))} ·
                  {l("%{n} new", n: @last_sync.summary.created)},
                  {l("%{n} refreshed", n: @last_sync.summary.updated)},
                  {l("%{n} unchanged", n: @last_sync.summary.unchanged)}
                  {#if @last_sync.summary.archived > 0}
                    , {l("%{n} archived", n: @last_sync.summary.archived)}
                  {/if}
                  {#if @last_sync.summary.errors != []}
                    , {l("%{n} error(s)", n: length(@last_sync.summary.errors))}
                  {/if}
                </span>
              {/if}
              <button
                id="ghost-sync-tiers"
                class="btn btn-primary btn-sm gap-2"
                phx-click="Bonfire.Ghost:sync_tiers"
                phx-target={@myself}
                disabled={@syncing}
              >
                {#if @syncing}
                  <span class="loading loading-spinner loading-xs" />
                  {l("Syncing…")}
                {#else}
                  <span class="iconify" data-icon="heroicons:arrow-path-rounded-square-20-solid" />
                  {l("Sync tiers")}
                {/if}
              </button>
            </div>
          </div>

          <p class="text-sm text-base-content mb-4">
            {l(
              "Turn each Ghost tier into a Bonfire circle. Admins can then grant these circles access anywhere in Bonfire's boundaries system."
            )}
          </p>

          {#if Config.get([:bonfire_ui_me, :login, :passwordless_only], false) == true}
            <p class="text-sm text-base-content mb-2">
              {l("Check the tiers required to log in to Bonfire. Leave all unchecked to allow any Ghost member.")}
            </p>
          {/if}

          <div class="flex flex-col gap-3">
            {#for tier <- @tiers}
              <div class={
                "card border transition-shadow hover:shadow-md",
                "border-base-content/10": tier["active"],
                "border-base-content/5 opacity-60": !tier["active"]
              }>
                <div class="card-body p-4 gap-1">
                  {#if Config.get([:bonfire_ui_me, :login, :passwordless_only], false) == true}
                    <form phx-change="Bonfire.Common.Settings:set" class="flex justify-end">
                      <Bonfire.UI.Common.SettingsToggleLive
                        keys={[:bonfire_ghost, :required_tier, tier["slug"]]}
                        scope={:instance}
                        name={l("Required for access")}
                      />
                    </form>
                  {/if}
                  <div class="flex items-center justify-between gap-2">
                    <h4 class="font-semibold text-lg">{tier["name"]}</h4>
                    <div class="flex gap-1 shrink-0">
                      {#if !tier["active"]}
                        <span class="badge badge-xs badge-warning">{l("archived")}</span>
                      {/if}
                      {#if tier["visibility"] == "none"}
                        <span class="badge badge-xs badge-ghost">{l("hidden")}</span>
                      {/if}
                    </div>
                  </div>

                  {#if desc = tier["description"]}
                    <p class="text-sm text-base-content">{desc}</p>
                  {/if}

                  <div class="mt-auto pt-3">
                    {#if tier["type"] == "paid"}
                      <div class="flex items-baseline gap-1 flex-wrap">
                        <span class="text-2xl font-bold">{format_price(tier["monthly_price"], tier["currency"])}</span>
                        <span class="text-sm text-base-content/50">/{l("mo")}</span>
                      </div>
                      {#if tier["yearly_price"]}
                        <p class="text-sm text-base-content/50 mt-0.5">
                          {format_price(tier["yearly_price"], tier["currency"])}/{l("yr")}
                        </p>
                      {/if}
                    {#else}
                      <span class="text-2xl font-bold">{l("Free")}</span>
                    {/if}
                  </div>

                  {#if benefits = tier["benefits"]}
                    {#if benefits != []}
                      <ul class="mt-3 space-y-1 border-t border-base-content/5 pt-3">
                        {#for benefit <- benefits}
                          <li class="flex items-center gap-2 text-sm">
                            <span class="iconify text-success shrink-0" data-icon="heroicons:check-20-solid" />
                            {benefit}
                          </li>
                        {/for}
                      </ul>
                    {/if}
                  {/if}
                </div>
              </div>
            {/for}
          </div>
        </div>
      </div>
    {/if}

    {!-- Members Section --}
    {#if Bonfire.Ghost.admin_configured?()}
      <div class="card bg-base-100 border border-base-content/10">
        <div class="card-body">
          <div class="flex items-center justify-between mb-4">
            <h3 class="card-title">
              {l("Members")}
              {#if @page_info}
                <span class="badge badge-ghost">{@page_info.total}</span>
              {/if}
            </h3>
          </div>

          {#if @members == []}
            <div class="text-center py-8 text-muted">
              <span class="iconify text-4xl mb-2" data-icon="heroicons:users" />
              <p>{l("No members found")}</p>
            </div>
          {#else}
            <div class="overflow-x-auto">
              <table class="table table-zebra w-full">
                <thead>
                  <tr>
                    <th>{l("Email")}</th>
                    <th>{l("Name")}</th>
                    <th>{l("Status")}</th>
                    <th>{l("Subscribed")}</th>
                    <th>{l("Joined")}</th>
                  </tr>
                </thead>
                <tbody>
                  {#for member <- @members}
                    <tr>
                      <td>
                        <span class="font-mono text-sm">{member["email"]}</span>
                      </td>
                      <td>{member["name"] || "-"}</td>
                      <td>
                        <span class={"badge badge-sm #{status_badge_class(member["status"])}"}>
                          {member["status"]}
                        </span>
                      </td>
                      <td>
                        {#if member["subscribed"]}
                          <span class="iconify text-lg text-success" data-icon="heroicons:check-circle-solid" />
                        {#else}
                          <span class="iconify text-lg text-base-content/30" data-icon="heroicons:x-circle-solid" />
                        {/if}
                      </td>
                      <td class="text-sm text-base-content">
                        {format_date(member["created_at"])}
                      </td>
                    </tr>
                  {/for}
                </tbody>
              </table>
            </div>

            {!-- Load More --}
            {#if @page_info && @page_info.has_next}
              <div class="flex justify-center mt-4">
                <button class="btn btn-ghost btn-sm" phx-click="Bonfire.Ghost:load_more" phx-target={@myself}>
                  {l("Load more")}
                </button>
              </div>
            {/if}
          {/if}
        </div>
      </div>
    {#else}
      <div class="alert">
        <span class="iconify" data-icon="heroicons:information-circle" />
        <div>
          <h3 class="font-bold">{l("Admin API not configured")}</h3>
          <p class="text-sm">{l("Set GHOST_ADMIN_API_KEY to access member data")}</p>
        </div>
      </div>
    {/if}
  {/if}

  {!-- Error Display --}
  {#if @error}
    <div class="alert alert-error">
      <span class="iconify" data-icon="heroicons:exclamation-circle" />
      <div>
        <h3 class="font-bold">{l("Error")}</h3>
        <p class="text-sm">{inspect(@error)}</p>
      </div>
    </div>
  {/if}
</div>
